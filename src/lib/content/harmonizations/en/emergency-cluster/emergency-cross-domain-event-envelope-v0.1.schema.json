            "partial",
            "pending",
            "completed",
            "contested",
            "reopened"
          ]
        },
        "termination_record_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "restoration_record_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
