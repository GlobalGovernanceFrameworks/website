{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globalgovernanceframeworks.org/schemas/emergency/cdee/0.1/schema.json",
  "title": "Emergency Cross-Domain Event Envelope v0.1",
  "description": "Non-authoritative transport wrapper for shared event identity, routing, responsibility acknowledgement, custody, review, and closure across emergency-domain frameworks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_id",
    "envelope_schema_version",
    "cluster_event_id",
    "event_status",
    "created_at",
    "updated_at",
    "registrar",
    "stewardship",
    "event_topology",
    "observed_context",
    "domain_engagements",
    "responsibility_assignments",
    "handoffs",
    "custody_map",
    "public_information_coordination",
    "review_and_closure",
    "access_and_integrity",
    "non_authority_statement"
  ],
  "properties": {
    "envelope_id": {
      "type": "string",
      "minLength": 1
    },
    "envelope_schema_version": {
      "const": "CDEE/0.1"
    },
    "cluster_event_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "event_status": {
      "type": "string",
      "enum": [
        "alerted",
        "assessing",
        "coordinating",
        "active_response",
        "stabilizing",
        "transitioning",
        "closed",
        "reopened",
        "archived"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "registrar": {
      "$ref": "#/$defs/actor"
    },
    "stewardship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_steward",
        "stewardship_basis",
        "stewardship_scope",
        "next_review_at"
      ],
      "properties": {
        "current_steward": {
          "$ref": "#/$defs/actor"
        },
        "stewardship_basis": {
          "type": "string",
          "minLength": 1
        },
        "stewardship_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "identity",
              "routing",
              "acknowledgement_tracking",
              "topology",
              "access_index",
              "review_calendar",
              "closure_index"
            ]
          }
        },
        "next_review_at": {
          "type": "string",
          "format": "date-time"
        },
        "transfer_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stewardshipTransfer"
          }
        }
      }
    },
    "event_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_event_ids",
        "child_event_ids",
        "merged_from_event_ids",
        "split_from_event_id",
        "related_event_ids"
      ],
      "properties": {
        "parent_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "child_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "merged_from_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "merged_into_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "split_from_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "related_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/eventRelation"
          }
        },
        "topology_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "observed_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_observed_at",
        "reported_at",
        "locations",
        "affected_territories",
        "affected_systems",
        "hazard_hypotheses",
        "origin_hypotheses",
        "state_estimate_refs",
        "dissent_refs"
      ],
      "properties": {
        "first_observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reported_at": {
          "type": "string",
          "format": "date-time"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "affected_territories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/territory"
          }
        },
        "affected_systems": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "hazard_hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hypothesis"
          }
        },
        "origin_hypotheses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hypothesis"
          }
        },
        "state_estimate_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "dissent_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public_summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "domain_engagements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/domainEngagement"
      }
    },
    "responsibility_assignments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/responsibilityAssignment"
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/handoff"
      }
    },
    "custody_map": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/custodyAssignment"
      }
    },
    "public_information_coordination": {
      "$ref": "#/$defs/publicInformation"
    },
    "review_and_closure": {
      "$ref": "#/$defs/reviewClosure"
    },
    "access_and_integrity": {
      "$ref": "#/$defs/accessIntegrity"
    },
    "non_authority_statement": {
      "const": "This envelope coordinates identity, routing, acknowledgement, custody, review, and closure. It does not declare an emergency, establish causation, assign liability, create jurisdiction, activate power, transfer command, compel disclosure, or keep emergency authority alive."
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "ref_type"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "minLength": 1
        },
        "ref_type": {
          "type": "string",
          "enum": [
            "ecrc_record",
            "domain_record",
            "authority_instrument",
            "event",
            "case",
            "order",
            "dataset",
            "sample",
            "asset",
            "public_notice",
            "protected_annex",
            "other"
          ]
        },
        "canonical_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^ECRC-(0[1-9]|[12][0-9]|3[0-3])$"
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "integrity_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_class": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "AC-1",
            "AC-2",
            "AC-3",
            "AC-4",
            "AC-5",
            null
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_name",
        "actor_type"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_name": {
          "type": "string",
          "minLength": 1
        },
        "actor_type": {
          "type": "string",
          "enum": [
            "public_authority",
            "indigenous_authority",
            "professional_regulator",
            "operator",
            "mutual_aid_network",
            "court_or_review_body",
            "observer",
            "custodian",
            "community_body",
            "other"
          ]
        },
        "authority_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "contact_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stewardshipTransfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_actor_id",
        "to_actor_id",
        "offered_at",
        "status"
      ],
      "properties": {
        "from_actor_id": {
          "type": "string"
        },
        "to_actor_id": {
          "type": "string"
        },
        "offered_at": {
          "type": "string",
          "format": "date-time"
        },
        "accepted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "offered",
            "accepted",
            "rejected",
            "withdrawn",
            "completed"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "eventRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "relation_type"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "relation_type": {
          "type": "string",
          "enum": [
            "causal_hypothesis",
            "shared_asset",
            "shared_population",
            "shared_territory",
            "shared_evidence",
            "cascading_dependency",
            "possible_duplicate",
            "administrative_only",
            "other"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_id",
        "description"
      ],
      "properties": {
        "location_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "geometry_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "protected_location": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "territory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "territory_id",
        "territory_name",
        "authority_status"
      ],
      "properties": {
        "territory_id": {
          "type": "string"
        },
        "territory_name": {
          "type": "string"
        },
        "authority_status": {
          "type": "string",
          "enum": [
            "identified",
            "contested",
            "protected",
            "unknown"
          ]
        },
        "authority_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "statement",
        "status",
        "confidence_label",
        "supporting_refs",
        "contrary_refs",
        "last_updated_at"
      ],
      "properties": {
        "hypothesis_id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "active",
            "contested",
            "disfavored",
            "withdrawn",
            "unresolved"
          ]
        },
        "probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "confidence_label": {
          "type": "string",
          "enum": [
            "very_low",
            "low",
            "medium",
            "high",
            "very_high",
            "not_quantified"
          ]
        },
        "supporting_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "contrary_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "responsible_estimator": {
          "anyOf": [
            {
              "$ref": "#/$defs/actor"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "supersedes_hypothesis_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "domainEngagement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "framework_version",
        "engagement_status",
        "engaged_function",
        "responsible_actor",
        "engaged_at",
        "next_review_at"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "enum": [
            "pis",
            "global_health",
            "aethelred",
            "living_shield",
            "aegis",
            "justice",
            "aurora",
            "synoptic",
            "indigenous_interface",
            "finance",
            "work",
            "other"
          ]
        },
        "framework_version": {
          "type": "string"
        },
        "engagement_status": {
          "type": "string",
          "enum": [
            "notified",
            "invited",
            "assessing",
            "active",
            "supporting",
            "suspended",
            "declined",
            "terminated",
            "not_applicable"
          ]
        },
        "engaged_function": {
          "type": "string"
        },
        "responsible_actor": {
          "$ref": "#/$defs/actor"
        },
        "engaged_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "next_review_at": {
          "type": "string",
          "format": "date-time"
        },
        "authority_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "retained_duties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "responsibilityAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responsibility_id",
        "function",
        "scope",
        "status",
        "responsible_actor",
        "authority_refs",
        "effective_at",
        "review_at",
        "retained_duties"
      ],
      "properties": {
        "responsibility_id": {
          "type": "string"
        },
        "function": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "accepted",
            "active",
            "concurrent",
            "contested",
            "suspended",
            "transferred",
            "terminated",
            "unassigned"
          ]
        },
        "responsible_actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/actor"
            },
            {
              "type": "null"
            }
          ]
        },
        "authority_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "concurrent_group_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "retained_duties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflict_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_id",
        "responsibility_id",
        "sender_actor_id",
        "receiver_actor_id",
        "status",
        "offered_at",
        "response_due_at",
        "scope_offered",
        "sender_retained_duties"
      ],
      "properties": {
        "handoff_id": {
          "type": "string"
        },
        "responsibility_id": {
          "type": "string"
        },
        "sender_actor_id": {
          "type": "string"
        },
        "receiver_actor_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "offered",
            "received",
            "deficiency",
            "accepted",
            "rejected",
            "withdrawn",
            "concurrent",
            "superseded",
            "closed"
          ]
        },
        "offered_at": {
          "type": "string",
          "format": "date-time"
        },
        "received_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "response_due_at": {
          "type": "string",
          "format": "date-time"
        },
        "responded_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "effective_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "closed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "scope_offered": {
          "type": "string"
        },
        "accepted_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "sender_retained_duties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "receiver_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deficiencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "record_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "custody_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "custodyAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custody_id",
        "object_class",
        "object_description",
        "current_custodian",
        "authority_refs",
        "access_class",
        "purpose_limits",
        "disposition_trigger",
        "status"
      ],
      "properties": {
        "custody_id": {
          "type": "string"
        },
        "object_class": {
          "type": "string",
          "enum": [
            "evidence",
            "data",
            "sample",
            "model",
            "log",
            "credential",
            "asset",
            "protected_knowledge",
            "source_identity",
            "classified_information",
            "other"
          ]
        },
        "object_description": {
          "type": "string"
        },
        "current_custodian": {
          "$ref": "#/$defs/actor"
        },
        "authority_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "access_class": {
          "type": "string",
          "enum": [
            "AC-1",
            "AC-2",
            "AC-3",
            "AC-4",
            "AC-5"
          ]
        },
        "purpose_limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transfer_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protected_non_transfer": {
          "type": "boolean",
          "default": false
        },
        "disposition_trigger": {
          "type": "string"
        },
        "disposition_record_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "transfer_pending",
            "transferred",
            "return_pending",
            "disposition_pending",
            "closed",
            "contested"
          ]
        }
      }
    },
    "publicInformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordination_status",
        "owners",
        "public_notice_refs",
        "correction_owner",
        "next_update_at",
        "unresolved_public_conflicts"
      ],
      "properties": {
        "coordination_status": {
          "type": "string",
          "enum": [
            "unassigned",
            "single_owner",
            "multiple_owners",
            "contested",
            "terminated"
          ]
        },
        "owners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actor"
          }
        },
        "public_notice_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "correction_owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/actor"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_update_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "language_and_accessibility_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_public_conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
