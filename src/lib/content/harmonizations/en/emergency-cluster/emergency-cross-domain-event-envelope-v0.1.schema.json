          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "closure_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "closed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "closure_authority_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "unresolved_register_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "reopen_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "accessIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_access_class",
        "public_index_fields",
        "protected_field_groups",
        "correction_history",
        "integrity_hash",
        "schema_validation_status"
      ],
      "properties": {
        "envelope_access_class": {
          "type": "string",
          "enum": [
            "AC-1",
            "AC-2",
            "AC-3",
            "AC-4",
            "AC-5"
          ]
        },
        "public_index_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protected_field_groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "correction_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/correction"
          }
        },
        "integrity_hash": {
          "type": "string",
          "minLength": 1
        },
        "signature_refs": {
          "type": "array",
          "items": {
