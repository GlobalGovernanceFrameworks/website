          }
        },
        "schema_validation_status": {
          "type": "string",
          "enum": [
            "valid",
            "invalid",
            "pending",
            "valid_with_warnings"
          ]
        },
        "validation_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
