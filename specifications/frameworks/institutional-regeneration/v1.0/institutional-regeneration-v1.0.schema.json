{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.globalgovernanceframeworks.org/irf/1.0/institutional-regeneration-v1.0.schema.json",
  "title": "IRF v1.0 record envelope",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "created_at",
    "status",
    "normative_force",
    "authority_effect",
    "action_class",
    "source_framework_id",
    "source_framework_version",
    "actor_id",
    "actor_type",
    "affected_party_refs",
    "protected_domain_flags",
    "access_class",
    "public_summary",
    "data_purpose",
    "correction_status",
    "challenge_status",
    "closure_state",
    "handoff_state",
    "hashes_and_signatures",
    "human_accountable_officer",
    "prohibited_inferences",
    "consequence_profile",
    "adoption_state",
    "reform_classes",
    "evidence_access_status",
    "minimum_causal_adequacy_status",
    "irf_payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^irf:[A-Za-z0-9._:-]+$"
    },
    "record_type": {
      "enum": [
        "IRF-01",
        "IRF-02",
        "IRF-03",
        "IRF-04",
        "IRF-05",
        "IRF-06",
        "IRF-07",
        "IRF-08",
        "IRF-09",
        "IRF-10",
        "IRF-11",
        "IRF-12",
        "IRF-13",
        "IRF-14",
        "IRF-15",
        "IRF-16",
        "IRF-17",
        "IRF-18",
        "IRF-19",
        "IRF-20",
        "IRF-21",
        "IRF-22",
        "IRF-23",
        "IRF-24",
        "IRF-25",
        "IRF-26",
        "IRF-27",
        "IRF-28",
        "IRF-29",
        "IRF-30",
        "IRF-31",
        "IRF-32",
        "IRF-33",
        "IRF-34",
        "IRF-35",
        "IRF-36",
        "IRF-37",
        "IRF-38",
        "IRF-39",
        "IRF-40",
        "IRF-41",
        "IRF-42",
        "IRF-43",
        "IRF-44",
        "IRF-45",
        "IRF-46",
        "IRF-47",
        "IRF-48",
        "IRF-49",
        "IRF-50"
      ]
    },
    "schema_version": {
      "const": "IRF/1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "draft",
        "asserted",
        "received",
        "validated_for_purpose",
        "referred",
        "proposed",
        "under_deliberation",
        "consent_pending",
        "authority_pending",
        "authorized",
        "registered",
        "activated",
        "paused",
        "suspended",
        "expired",
        "terminated",
        "closed",
        "corrected",
        "superseded",
        "rejected",
        "unresolved",
        "non_activated"
      ]
    },
    "normative_force": {
      "enum": [
        "descriptive",
        "advisory",
        "procedural",
        "evidentiary",
        "consent",
        "authorizing",
        "activating",
        "executing",
        "closing"
      ]
    },
    "authority_effect": {
      "enum": [
        "none",
        "advisory",
        "procedural_support",
        "evidentiary",
        "consent_evidence",
        "authority_reference",
        "authorizing",
        "activating",
        "executing",
        "closing"
      ]
    },
    "action_class": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "J",
        "K",
        "L",
        "M",
        "N",
        "O",
        "P"
      ]
    },
    "source_framework_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_framework_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_type": {
      "enum": [
        "human",
        "community",
        "public_body",
        "private_organization",
        "indigenous_nation",
        "ai_system",
        "sensor",
        "technical_service",
        "other"
      ]
    },
    "office_or_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "representation_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "technical_credential_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constituting_instrument": {
      "type": [
        "string",
        "null"
      ]
    },
    "legal_power": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction_territorial": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction_personal": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction_subject_matter": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction_temporal": {
      "type": [
        "string",
        "null"
      ]
    },
    "affected_party_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_indigenous_nation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protected_domain_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consent_record_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_record_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activation_record_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "access_class": {
      "enum": [
        "PUBLIC",
        "AFFECTED_PARTIES",
        "DECISION_BODY",
        "INDEPENDENT_REVIEW",
        "PROTECTED_PERSONAL",
        "PROTECTED_INDIGENOUS",
        "PROTECTED_SOURCE",
        "SECURITY_RESTRICTED",
        "SEALED_LEGAL"
      ]
    },
    "public_summary": {
      "type": "string",
      "minLength": 1
    },
    "protected_annex_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_purpose": {
      "type": [
        "string",
        "null"
      ]
    },
    "retention_rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "correction_status": {
      "enum": [
        "none",
        "requested",
        "under_review",
        "corrected",
        "retracted",
        "superseded"
      ]
    },
    "challenge_status": {
      "enum": [
        "none",
        "open",
        "interim_relief",
        "decided",
        "appealed",
        "closed"
      ]
    },
    "review_due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "closure_state": {
      "enum": [
        "not_applicable",
        "open",
        "closing",
        "closed",
        "unresolved_duties"
      ]
    },
    "unresolved_duty_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff_state": {
      "enum": [
        "not_applicable",
        "offered",
        "acknowledged",
        "accepted",
        "partially_accepted",
        "capacity_limited",
        "refused",
        "deferred",
        "referred",
        "timed_out",
        "misrouted",
        "constitutional_gap",
        "returned",
        "closed"
      ]
    },
    "recipient_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recipient_acceptance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hashes_and_signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "algorithm",
          "value"
        ],
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "human_accountable_officer": {
      "type": "string",
      "minLength": 1
    },
    "prohibited_inferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "consequence_profile": {
      "enum": [
        "CP0",
        "CP1",
        "CP2",
        "CP3"
      ]
    },
    "adoption_state": {
      "enum": [
        "exploratory",
        "advisory_use",
        "voluntary_internal_pilot",
        "contractually_supported",
        "charter_change_proposed",
        "lawfully_amended",
        "transition_proposed",
        "transition_authorized",
        "closing",
        "closed_with_unresolved_duties",
        "closed"
      ]
    },
    "reform_classes": {
      "type": "array",
      "items": {
        "enum": [
          "symptom",
          "capacity",
          "incentive",
          "authority",
          "reproductive"
        ]
      },
      "uniqueItems": true
    },
    "evidence_access_status": {
      "type": "array",
      "items": {
        "enum": [
          "available",
          "legally protected",
          "operationally inaccessible",
          "refused by a named authority",
          "destroyed or missing",
          "disputed",
          "outside jurisdiction."
        ]
      },
      "uniqueItems": true
    },
    "authority_formation": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "retained",
        "delegated",
        "transferred",
        "concurrent",
        "jointly_constituted",
        "absent"
      ]
    },
    "response_duty_effect": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "legal",
        "contractual",
        "charter_internal",
        "voluntary_commitment",
        "advisory",
        "none"
      ]
    },
    "response_duty_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "acknowledgment_clock_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_clock_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "response_time_assessment_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "provisional_safe_state_record_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "post_acceptance_action_clock_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "pilot_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "acceptability",
        "feasibility",
        "mechanism",
        "operational",
        "system_effect",
        "institutionalization",
        "not_applicable"
      ]
    },
    "minimum_causal_adequacy_status": {
      "enum": [
        "not_assessed",
        "adequate_for_claim",
        "narrowed",
        "redesign_required",
        "upstream_action_required",
        "impossible",
        "not_applicable"
      ]
    },
    "irf_payload": {
      "type": "object",
      "properties": {
        "institution_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "programme_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "stated_mandate": {
          "type": [
            "string",
            "null"
          ]
        },
        "revealed_purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "causal_controller_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selection_pressure_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "common_mode_dependency_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "impossible_mandate_status": {
          "enum": [
            "not_assessed",
            "not_present",
            "capacity_limited",
            "constitutional_gap",
            "contradictory_duties",
            "upstream_cooperation_required"
          ]
        },
        "adoption_integrity_statement_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "ordinary_owner_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "support_withdrawal_plan_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "successor_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "unresolved_duty_custody_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "framework_falsification_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "conclusions_not_supported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "consequence_profile": {
            "enum": [
              "CP2",
              "CP3"
            ]
          }
        }
      },
      "then": {
        "required": [
          "authority_formation",
          "response_duty_effect"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "IRF-38"
          }
        }
      },
      "then": {
        "required": [
          "recipient_refs",
          "response_duty_effect",
          "response_duty_source",
          "acknowledgment_clock_source",
          "decision_clock_source"
        ],
        "properties": {
          "recipient_refs": {
            "minItems": 1
          },
          "handoff_state": {
            "enum": [
              "offered",
              "acknowledged",
              "accepted",
              "partially_accepted",
              "capacity_limited",
              "refused",
              "deferred",
              "referred",
              "timed_out",
              "misrouted",
              "constitutional_gap",
              "returned",
              "closed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "enum": [
              "IRF-20",
              "IRF-26"
            ]
          }
        }
      },
      "then": {
        "required": [
          "pilot_type",
          "minimum_causal_adequacy_status"
        ],
        "properties": {
          "pilot_type": {
            "enum": [
              "acceptability",
              "feasibility",
              "mechanism",
              "operational",
              "system_effect",
              "institutionalization"
            ]
          },
          "minimum_causal_adequacy_status": {
            "enum": [
              "adequate_for_claim",
              "narrowed",
              "redesign_required",
              "upstream_action_required",
              "impossible"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "IRF-48"
          }
        }
      },
      "then": {
        "required": [
          "constituting_instrument",
          "legal_power",
          "authority_record_refs"
        ],
        "properties": {
          "authority_record_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "enum": [
              "IRF-49",
              "IRF-50"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "closure_state": {
            "enum": [
              "closing",
              "closed",
              "unresolved_duties"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "activated"
          }
        }
      },
      "then": {
        "required": [
          "effective_at",
          "authority_record_refs",
          "activation_record_refs"
        ],
        "properties": {
          "authority_record_refs": {
            "minItems": 1
          },
          "activation_record_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority_effect": {
            "enum": [
              "authorizing",
              "activating",
              "executing"
            ]
          }
        }
      },
      "then": {
        "required": [
          "authority_record_refs"
        ],
        "properties": {
          "authority_record_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
