{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.globalgovernanceframeworks.org/irf/1.0/institutional-regeneration-v1.0-specification.schema.json",
  "title": "IRF v1.0 machine-readable specification catalogue",
  "type": "object",
  "required": [
    "framework_id",
    "version",
    "date",
    "source_lineage",
    "constitutional_interface",
    "controlling_interface",
    "action_classes",
    "reform_classes",
    "adoption_states",
    "evidence_access_states",
    "consequence_profiles",
    "handoff_states",
    "authority_formation_states",
    "common_header_fields",
    "records",
    "gmeaia_crosswalk",
    "readiness_gates",
    "compound_tests",
    "framework_hypotheses",
    "active_cluster_registry",
    "cluster_peer_dependencies"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.globalgovernanceframeworks.org/irf/1.0/institutional-regeneration-v1.0-specification.schema.json"
    },
    "framework_id": {
      "const": "IRF/1.0"
    },
    "version": {
      "const": "1.0"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "legal_character": {
      "type": "string"
    },
    "non_authority_clause": {
      "type": "string"
    },
    "release_doctrine": {
      "type": "string"
    },
    "action_class_assignment_basis": {
      "type": "string"
    },
    "constitutional_interface": {
      "const": "CIS/0.2.1"
    },
    "controlling_interface": {
      "const": "GMEAIA/0.2.1"
    },
    "event_transport": {
      "const": "EGP/1.2"
    },
    "implementation_companion": {
      "const": "IAF/1.2"
    },
    "tool_commons": {
      "const": "IMT/0.9"
    },
    "deliberation_companion": {
      "const": "WDIP/1.7"
    },
    "coordination_interface": {
      "const": "META-GOVERNANCE/1.6"
    },
    "economic_coordination_companion": {
      "const": "NESTED-ECONOMIES/3.3"
    },
    "source_lineage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "filename",
          "sha256",
          "bytes"
        ],
        "properties": {
          "filename": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "action_classes": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scope"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-P]$"
          },
          "scope": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "reform_classes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "adoption_states": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "string"
      }
    },
    "evidence_access_states": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "string"
      }
    },
    "consequence_profiles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "handoff_states": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "string"
      }
    },
    "authority_formation_states": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    },
    "response_duty_effects": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    },
    "common_header_fields": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48
    },
    "records": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "purpose",
          "action_class",
          "primary_gmeaia_mappings"
        ],
        "properties": {
          "id": {
            "pattern": "^IRF-(0[1-9]|[1-4][0-9]|50)$"
          },
          "title": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "action_class": {
            "pattern": "^[A-P]$"
          },
          "primary_gmeaia_mappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "pattern": "^GMEAIA-(0[1-9]|[1-5][0-9]|60)$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "gmeaia_crosswalk": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "gmeaia_record",
          "gmeaia_title",
          "irf_records",
          "boundary"
        ],
        "properties": {
          "gmeaia_record": {
            "pattern": "^GMEAIA-(0[1-9]|[1-5][0-9]|60)$"
          },
          "gmeaia_title": {
            "type": "string"
          },
          "irf_records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "pattern": "^IRF-(0[1-9]|[1-4][0-9]|50)$"
            }
          },
          "boundary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "readiness_gates": {
      "type": "array",
      "minItems": 45,
      "maxItems": 45
    },
    "compound_tests": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48
    },
    "framework_hypotheses": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8
    },
    "narrowing_conditions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7
    },
    "active_cluster_registry": {
      "const": "IAEG-CLUSTER/1.0"
    },
    "cluster_peer_dependencies": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "binding",
          "exact_package_hash_source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "binding": {
            "const": "IAEG-CLUSTER/1.0"
          },
          "exact_package_hash_source": {
            "const": "active_cluster_registry"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
