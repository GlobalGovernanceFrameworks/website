{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.globalgovernanceframeworks.org/wdip/1.7/wise-decision-making-integration-protocol-v1.7-specification.schema.json",
  "title": "WDIP v1.7 Specification Catalogue",
  "type": "object",
  "required": [
    "protocol_id",
    "version",
    "status",
    "constitutional_interface",
    "controlling_interface",
    "action_classes",
    "consequence_profiles",
    "handoff_states",
    "common_header_fields",
    "records",
    "gmeaia_crosswalk",
    "readiness_gates",
    "compound_tests"
  ],
  "properties": {
    "protocol_id": {
      "const": "WDIP/1.7"
    },
    "version": {
      "const": "1.7"
    },
    "status": {
      "const": "document_and_machine_compatible"
    },
    "constitutional_interface": {
      "type": "object"
    },
    "controlling_interface": {
      "type": "object"
    },
    "action_classes": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16
    },
    "consequence_profiles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "handoff_states": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13
    },
    "common_header_fields": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "string"
      }
    },
    "records": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "action_class",
          "purpose"
        ]
      }
    },
    "gmeaia_crosswalk": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60
    },
    "readiness_gates": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40
    },
    "compound_tests": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36
    }
  },
  "additionalProperties": true
}
