{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.globalgovernanceframeworks.org/egp/1.2/governance-action.schema.json",
  "title": "EGP/1.2 Governance Action",
  "description": "Structural schema. Validation does not establish factual, constitutional, legal, causal, or ethical validity.",
  "type": "object",
  "required": [
    "egp_package",
    "event_id",
    "operation",
    "created_at",
    "created_by",
    "event_version",
    "consequence_profile_claim",
    "access_class",
    "correction_status",
    "authority_effect",
    "payload"
  ],
  "properties": {
    "egp_package": {
      "const": "EGP/1.2"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "sense",
        "propose",
        "adopt"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "object",
      "required": [
        "actor_id",
        "actor_type",
        "capacity_claim"
      ],
      "properties": {
        "actor_id": {
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "human",
            "group",
            "institution",
            "ai_assistant",
            "sensor",
            "service"
          ]
        },
        "capacity_claim": {
          "type": "string"
        },
        "identity_proof_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "event_version": {
      "type": "string"
    },
    "consequence_profile_claim": {
      "enum": [
        "CP0",
        "CP1",
        "CP2",
        "CP3",
        "unknown"
      ]
    },
    "jurisdiction_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "geographic_scope_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "institutional_scope_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language": {
      "type": "string"
    },
    "access_class": {
      "enum": [
        "public",
        "community",
        "affected_party",
        "operational",
        "review",
        "restricted",
        "protected",
        "sealed",
        "metadata_only",
        "deleted_or_shredded"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationship_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correction_status": {
      "enum": [
        "current",
        "corrected",
        "disputed",
        "withdrawn",
        "superseded"
      ]
    },
    "authority_effect": {
      "enum": [
        "none",
        "advisory",
        "claim_only",
        "voluntary_internal",
        "consequential_reference"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "gref": {
      "type": "string",
      "pattern": "^gmeaia:GMEAIA-[0-9]{2}:.+"
    },
    "grefNullable": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^gmeaia:GMEAIA-[0-9]{2}:.+"
    },
    "handoff": {
      "enum": [
        "offered",
        "acknowledged",
        "accepted",
        "partially_accepted",
        "capacity_limited",
        "refused",
        "deferred",
        "referred",
        "timed_out",
        "misrouted",
        "constitutional_gap",
        "returned",
        "closed",
        "not_applicable"
      ]
    },
    "authorityFormation": {
      "enum": [
        "retained",
        "delegated",
        "transferred",
        "concurrent",
        "jointly_constituted",
        "absent"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "sense"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "claim_status",
              "observation_type",
              "asserted_severity",
              "asserted_urgency",
              "uncertainty",
              "affected_party_claims",
              "evidence_refs",
              "requested_routes",
              "protected_domain_flags"
            ],
            "properties": {
              "claim_status": {
                "enum": [
                  "asserted",
                  "validation_pending",
                  "validated",
                  "disputed",
                  "rejected",
                  "withdrawn",
                  "superseded"
                ]
              },
              "observation_type": {
                "enum": [
                  "direct",
                  "reported",
                  "sensor",
                  "model",
                  "allegation",
                  "opportunity",
                  "request",
                  "complaint"
                ]
              },
              "asserted_severity": {
                "enum": [
                  "informational",
                  "low",
                  "moderate",
                  "high",
                  "critical",
                  "unknown"
                ]
              },
              "asserted_urgency": {
                "enum": [
                  "none",
                  "hours",
                  "days",
                  "weeks",
                  "months",
                  "years",
                  "unknown"
                ]
              },
              "uncertainty": {
                "type": "string"
              },
              "affected_party_claims": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requested_routes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "protected_domain_flags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "gmeaia_refs": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "propose"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "responds_to_refs",
              "problem_definition",
              "alternatives",
              "proposed_consequence_profile",
              "required_authority_types",
              "protected_domain_flags",
              "test_criteria",
              "minimum_causal_adequacy"
            ],
            "properties": {
              "responds_to_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "problem_definition": {
                "type": "string"
              },
              "alternatives": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object"
                }
              },
              "affected_party_map_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "affected_indigenous_authority_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "causal_mechanism_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "causal_responsibility_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "proposed_authority_formation": {
                "enum": [
                  "retained",
                  "delegated",
                  "transferred",
                  "concurrent",
                  "jointly_constituted",
                  "absent",
                  "unknown"
                ]
              },
              "proposed_consequence_profile": {
                "enum": [
                  "CP0",
                  "CP1",
                  "CP2",
                  "CP3"
                ]
              },
              "required_authority_types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "protected_domain_flags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "resource_estimate": {
                "type": "object"
              },
              "response_and_action_clock_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "test_criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "minimum_causal_adequacy": {
                "type": "string"
              },
              "monitoring_plan_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "proposed_start": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "proposed_end": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "rollback_plan_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "remedy_plan_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "adopt"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "proposal_ref",
              "adopting_actor_ref",
              "effect_label",
              "consequence_profile",
              "authority_resolution",
              "consent_resolution",
              "authorization_resolution",
              "activation_resolution",
              "protected_domain_resolution",
              "handoff_resolution",
              "clocks",
              "safeguards"
            ],
            "properties": {
              "proposal_ref": {
                "type": "string"
              },
              "adopting_actor_ref": {
                "type": "string"
              },
              "effect_label": {
                "enum": [
                  "claim_only",
                  "expressive",
                  "voluntary_internal",
                  "authorized_trial_not_active",
                  "active_bounded_trial",
                  "suspended",
                  "terminated",
                  "closed",
                  "permanent_enactment_reference",
                  "invalid_or_rejected"
                ]
              },
              "consequence_profile": {
                "enum": [
                  "CP0",
                  "CP1",
                  "CP2",
                  "CP3"
                ]
              },
              "authority_resolution": {
                "type": "object",
                "required": [
                  "status",
                  "authority_formation"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "unverified",
                      "valid",
                      "invalid",
                      "expired",
                      "suspended",
                      "withdrawn"
                    ]
                  },
                  "authority_and_causal_responsibility_ref": {
                    "$ref": "#/$defs/gref"
                  },
                  "authority_formation": {
                    "$ref": "#/$defs/authorityFormation"
                  }
                },
                "additionalProperties": true
              },
              "consent_resolution": {
                "type": "object",
                "required": [
                  "status",
                  "refs"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "not_applicable",
                      "pending",
                      "valid",
                      "invalid",
                      "withdrawn",
                      "disputed",
                      "expired"
                    ]
                  },
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": true
              },
              "authorization_resolution": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "absent",
                      "pending",
                      "granted",
                      "denied",
                      "expired",
                      "withdrawn"
                    ]
                  },
                  "authorization_ref": {
                    "$ref": "#/$defs/gref"
                  },
                  "trial_authorization_ref": {
                    "$ref": "#/$defs/gref"
                  },
                  "permanent_enactment_ref": {
                    "$ref": "#/$defs/gref"
                  }
                },
                "additionalProperties": true
              },
              "activation_resolution": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "inactive",
                      "scheduled",
                      "active",
                      "paused",
                      "terminated"
                    ]
                  },
                  "activation_ref": {
                    "$ref": "#/$defs/grefNullable"
                  }
                },
                "additionalProperties": true
              },
              "protected_domain_resolution": {
                "type": "object",
                "required": [
                  "flags"
                ],
                "properties": {
                  "flags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "specialized_interface_ref": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "authorization_ref": {
                    "$ref": "#/$defs/grefNullable"
                  }
                },
                "additionalProperties": true
              },
              "handoff_resolution": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "$ref": "#/$defs/handoff"
                  },
                  "handoff_ref": {
                    "$ref": "#/$defs/grefNullable"
                  }
                },
                "additionalProperties": true
              },
              "clocks": {
                "type": "object",
                "properties": {
                  "authorized_from": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "authorized_until": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "acknowledgment_due": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "decision_due": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "action_due": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "review_due": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "automatic_expiry": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  }
                },
                "additionalProperties": false
              },
              "safeguards": {
                "type": "object",
                "properties": {
                  "rights_and_continuing_duties_ref": {
                    "$ref": "#/$defs/gref"
                  },
                  "implementation_plan_ref": {
                    "$ref": "#/$defs/gref"
                  },
                  "monitoring_ref": {
                    "$ref": "#/$defs/gref"
                  },
                  "challenge_and_interim_relief_ref": {
                    "$ref": "#/$defs/gref"
                  },
                  "pause_rollback_ref": {
                    "$ref": "#/$defs/gref"
                  },
                  "closure_and_authority_return_ref": {
                    "$ref": "#/$defs/gref"
                  },
                  "data_disposition_ref": {
                    "$ref": "#/$defs/gref"
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "adopt"
          },
          "payload": {
            "properties": {
              "consequence_profile": {
                "enum": [
                  "CP2",
                  "CP3"
                ]
              }
            }
          }
        },
        "required": [
          "operation",
          "payload"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "authority_resolution": {
                "required": [
                  "authority_and_causal_responsibility_ref"
                ]
              },
              "authorization_resolution": {
                "required": [
                  "authorization_ref"
                ]
              },
              "safeguards": {
                "required": [
                  "rights_and_continuing_duties_ref",
                  "implementation_plan_ref",
                  "monitoring_ref",
                  "challenge_and_interim_relief_ref",
                  "pause_rollback_ref",
                  "closure_and_authority_return_ref"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "adopt"
          },
          "payload": {
            "properties": {
              "effect_label": {
                "enum": [
                  "authorized_trial_not_active",
                  "active_bounded_trial"
                ]
              }
            }
          }
        },
        "required": [
          "operation",
          "payload"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "authorization_resolution": {
                "required": [
                  "trial_authorization_ref"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "adopt"
          },
          "payload": {
            "properties": {
              "effect_label": {
                "const": "permanent_enactment_reference"
              }
            }
          }
        },
        "required": [
          "operation",
          "payload"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "authorization_resolution": {
                "required": [
                  "permanent_enactment_ref"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "adopt"
          },
          "payload": {
            "properties": {
              "consequence_profile": {
                "const": "CP3"
              }
            }
          }
        },
        "required": [
          "operation",
          "payload"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "protected_domain_resolution": {
                "required": [
                  "specialized_interface_ref",
                  "authorization_ref"
                ],
                "properties": {
                  "specialized_interface_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "authorization_ref": {
                    "$ref": "#/$defs/gref"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
