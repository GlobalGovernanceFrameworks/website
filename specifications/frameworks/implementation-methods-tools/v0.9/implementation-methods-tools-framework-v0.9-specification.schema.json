{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.globalgovernanceframeworks.org/imt/0.9/implementation-methods-tools-framework-v0.9-specification.schema.json",
  "title": "IMT v0.9 specification catalogue",
  "type": "object",
  "required": [
    "framework_id",
    "version",
    "date",
    "controlling_pins",
    "action_classes",
    "common_header_fields",
    "records",
    "gmeaia_crosswalk",
    "readiness_gates",
    "compound_tests"
  ],
  "properties": {
    "framework_id": {
      "const": "IMT/0.9"
    },
    "version": {
      "const": "0.9"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "controlling_pins": {
      "type": "object"
    },
    "action_classes": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16
    },
    "common_header_fields": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "uniqueItems": true
    },
    "records": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "action_class",
          "purpose",
          "prohibited_inference"
        ],
        "properties": {
          "id": {
            "pattern": "^IMT-[0-9]{2}$"
          },
          "action_class": {
            "pattern": "^A(0[1-9]|1[0-6])$"
          }
        },
        "additionalProperties": true
      }
    },
    "gmeaia_crosswalk": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60
    },
    "readiness_gates": {
      "type": "array",
      "minItems": 36
    },
    "compound_tests": {
      "type": "array",
      "minItems": 40
    }
  },
  "additionalProperties": true
}
