{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.globalgovernanceframeworks.org/iaf/1.2/implementation-and-adaptation-v1.2-specification.schema.json",
  "title": "IAF v1.2 machine-readable specification catalogue",
  "type": "object",
  "required": [
    "framework_id",
    "version",
    "date",
    "source_lineage",
    "constitutional_interface",
    "controlling_interface",
    "action_classes",
    "pilot_types",
    "complexity_bands",
    "consequence_profiles",
    "handoff_states",
    "authority_formation_states",
    "common_header_fields",
    "records",
    "gmeaia_crosswalk",
    "readiness_gates",
    "compound_tests",
    "framework_hypotheses",
    "active_cluster_registry",
    "cluster_peer_dependencies"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.globalgovernanceframeworks.org/iaf/1.2/implementation-and-adaptation-v1.2-specification.schema.json"
    },
    "framework_id": {
      "const": "IAF/1.2"
    },
    "version": {
      "const": "1.2"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "legal_character": {
      "type": "string"
    },
    "non_authority_clause": {
      "type": "string"
    },
    "release_doctrine": {
      "type": "string"
    },
    "constitutional_interface": {
      "const": "CIS/0.2.1"
    },
    "controlling_interface": {
      "const": "GMEAIA/0.2.1"
    },
    "event_transport": {
      "const": "EGP/1.2"
    },
    "tool_commons": {
      "const": "IMT/0.9"
    },
    "institutional_transition": {
      "const": "IRF/1.0"
    },
    "coordination_interface": {
      "const": "META-GOVERNANCE/1.6"
    },
    "source_lineage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "filename",
          "sha256",
          "bytes"
        ],
        "properties": {
          "filename": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "action_classes": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scope"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-P]$"
          },
          "scope": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "pilot_types": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "primary_question",
          "success_supports",
          "does_not_establish"
        ],
        "properties": {
          "id": {
            "enum": [
              "acceptability",
              "feasibility",
              "mechanism",
              "operational",
              "system_effect",
              "institutionalization"
            ]
          },
          "primary_question": {
            "type": "string"
          },
          "success_supports": {
            "type": "string"
          },
          "does_not_establish": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "complexity_bands": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "authority_consequence"
        ],
        "properties": {
          "id": {
            "enum": [
              "B1",
              "B2",
              "B3",
              "B4"
            ]
          },
          "description": {
            "type": "string"
          },
          "authority_consequence": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "consequence_profiles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "handoff_states": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "string"
      }
    },
    "authority_formation_states": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    },
    "response_duty_effects": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    },
    "common_header_fields": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48
    },
    "records": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "action_class",
          "primary_gmeaia_mappings",
          "purpose",
          "minimum_controls"
        ],
        "properties": {
          "id": {
            "pattern": "^IAF-(0[1-9]|[1-4][0-9]|50)$"
          },
          "title": {
            "type": "string"
          },
          "action_class": {
            "pattern": "^[A-P]$"
          },
          "primary_gmeaia_mappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "pattern": "^GMEAIA-(0[1-9]|[1-5][0-9]|60)$"
            }
          },
          "authority_effect_rule": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "minimum_controls": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "gmeaia_crosswalk": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "gmeaia_record",
          "iaf_records"
        ],
        "properties": {
          "gmeaia_record": {
            "pattern": "^GMEAIA-(0[1-9]|[1-5][0-9]|60)$"
          },
          "iaf_records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "pattern": "^IAF-(0[1-9]|[1-4][0-9]|50)$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "readiness_gates": {
      "type": "array",
      "minItems": 45,
      "maxItems": 45
    },
    "compound_tests": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48
    },
    "framework_hypotheses": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8
    },
    "active_cluster_registry": {
      "const": "IAEG-CLUSTER/1.0"
    },
    "cluster_peer_dependencies": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "binding",
          "exact_package_hash_source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "binding": {
            "const": "IAEG-CLUSTER/1.0"
          },
          "exact_package_hash_source": {
            "const": "active_cluster_registry"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
