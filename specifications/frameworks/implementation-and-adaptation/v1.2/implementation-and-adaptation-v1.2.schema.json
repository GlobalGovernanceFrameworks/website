{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.globalgovernanceframeworks.org/iaf/1.2/implementation-and-adaptation-v1.2.schema.json",
  "title": "IAF v1.2 record envelope",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "created_at",
    "status",
    "normative_force",
    "authority_effect",
    "action_class",
    "source_framework_id",
    "source_framework_version",
    "actor_id",
    "actor_type",
    "affected_party_refs",
    "protected_domain_flags",
    "access_class",
    "public_summary",
    "data_purpose",
    "correction_status",
    "challenge_status",
    "closure_state",
    "handoff_state",
    "hashes_and_signatures",
    "human_accountable_officer",
    "prohibited_inferences",
    "consequence_profile",
    "pilot_type",
    "pilot_complexity_band",
    "iaf_payload"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^iaf:[A-Za-z0-9._:-]+$"
    },
    "record_type": {
      "enum": [
        "IAF-01",
        "IAF-02",
        "IAF-03",
        "IAF-04",
        "IAF-05",
        "IAF-06",
        "IAF-07",
        "IAF-08",
        "IAF-09",
        "IAF-10",
        "IAF-11",
        "IAF-12",
        "IAF-13",
        "IAF-14",
        "IAF-15",
        "IAF-16",
        "IAF-17",
        "IAF-18",
        "IAF-19",
        "IAF-20",
        "IAF-21",
        "IAF-22",
        "IAF-23",
        "IAF-24",
        "IAF-25",
        "IAF-26",
        "IAF-27",
        "IAF-28",
        "IAF-29",
        "IAF-30",
        "IAF-31",
        "IAF-32",
        "IAF-33",
        "IAF-34",
        "IAF-35",
        "IAF-36",
        "IAF-37",
        "IAF-38",
        "IAF-39",
        "IAF-40",
        "IAF-41",
        "IAF-42",
        "IAF-43",
        "IAF-44",
        "IAF-45",
        "IAF-46",
        "IAF-47",
        "IAF-48",
        "IAF-49",
        "IAF-50"
      ]
    },
    "schema_version": {
      "const": "IAF/1.2"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "draft",
        "asserted",
        "received",
        "validated_for_purpose",
        "referred",
        "proposed",
        "under_deliberation",
        "consent_pending",
        "authority_pending",
        "authorized",
        "registered",
        "activated",
        "paused",
        "suspended",
        "expired",
        "terminated",
        "closed",
        "corrected",
        "superseded",
        "rejected",
        "unresolved",
        "non_activated"
      ]
    },
    "normative_force": {
      "enum": [
        "descriptive",
        "advisory",
        "procedural",
        "evidentiary",
        "consent",
        "authorizing",
        "activating",
        "executing",
        "closing"
      ]
    },
    "authority_effect": {
      "enum": [
        "none",
        "advisory",
        "procedural_support",
        "evidentiary",
        "consent_evidence",
        "authority_reference",
        "authorizing",
        "activating",
        "executing",
        "closing"
      ]
    },
    "action_class": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H",
        "I",
        "J",
        "K",
        "L",
        "M",
        "N",
        "O",
        "P"
      ]
    },
    "source_framework_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_framework_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_type": {
      "enum": [
        "human",
        "community",
        "public_body",
        "private_organization",
        "indigenous_nation",
        "ai_system",
        "sensor",
        "technical_service",
        "other"
      ]
    },
    "office_or_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "representation_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "technical_credential_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constituting_instrument": {
      "type": [
        "string",
        "null"
      ]
    },
    "legal_power": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction_territorial": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction_personal": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction_subject_matter": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction_temporal": {
      "type": [
        "string",
        "null"
      ]
    },
    "affected_party_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_indigenous_nation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protected_domain_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consent_record_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_record_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activation_record_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "access_class": {
      "enum": [
        "PUBLIC",
        "AFFECTED_PARTIES",
        "DECISION_BODY",
        "INDEPENDENT_REVIEW",
        "PROTECTED_PERSONAL",
        "PROTECTED_INDIGENOUS",
        "PROTECTED_SOURCE",
        "SECURITY_RESTRICTED",
        "SEALED_LEGAL"
      ]
    },
    "public_summary": {
      "type": "string",
      "minLength": 1
    },
    "protected_annex_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_purpose": {
      "type": [
        "string",
        "null"
      ]
    },
    "retention_rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "correction_status": {
      "enum": [
        "none",
        "requested",
        "under_review",
        "corrected",
        "retracted",
        "superseded"
      ]
    },
    "challenge_status": {
      "enum": [
        "none",
        "open",
        "interim_relief",
        "decided",
        "appealed",
        "closed"
      ]
    },
    "review_due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "closure_state": {
      "enum": [
        "not_applicable",
        "open",
        "closing",
        "closed",
        "unresolved_duties"
      ]
    },
    "unresolved_duty_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff_state": {
      "enum": [
        "not_applicable",
        "offered",
        "acknowledged",
        "accepted",
        "partially_accepted",
        "capacity_limited",
        "refused",
        "deferred",
        "referred",
        "timed_out",
        "misrouted",
        "constitutional_gap",
        "returned",
        "closed"
      ]
    },
    "recipient_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recipient_acceptance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hashes_and_signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "algorithm",
          "value"
        ],
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "human_accountable_officer": {
      "type": "string",
      "minLength": 1
    },
    "prohibited_inferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "consequence_profile": {
      "enum": [
        "CP0",
        "CP1",
        "CP2",
        "CP3"
      ]
    },
    "pilot_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "acceptability",
        "feasibility",
        "mechanism",
        "operational",
        "system_effect",
        "institutionalization",
        "not_applicable"
      ]
    },
    "pilot_complexity_band": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "B1",
        "B2",
        "B3",
        "B4",
        "not_applicable"
      ]
    },
    "authority_formation": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "retained",
        "delegated",
        "transferred",
        "concurrent",
        "jointly_constituted",
        "absent"
      ]
    },
    "response_duty_effect": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "legal",
        "contractual",
        "charter_internal",
        "voluntary_commitment",
        "advisory",
        "none"
      ]
    },
    "response_duty_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "acknowledgment_clock_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_clock_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "response_time_assessment_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "provisional_safe_state_record_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "post_acceptance_action_clock_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "iaf_payload": {
      "type": "object",
      "properties": {
        "implementation_principal_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "objective": {
          "type": [
            "string",
            "null"
          ]
        },
        "claimed_causal_mechanism": {
          "type": [
            "string",
            "null"
          ]
        },
        "controlled_variables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "upstream_dependency_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pilot_question": {
          "type": [
            "string",
            "null"
          ]
        },
        "conclusions_not_supported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minimum_causal_adequacy_status": {
          "enum": [
            "not_assessed",
            "adequate_for_claim",
            "narrowed",
            "redesign_required",
            "upstream_action_required",
            "impossible"
          ]
        },
        "ordinary_owner_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "support_withdrawal_plan_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "compatibility_effect": {
          "type": [
            "string",
            "null"
          ]
        },
        "learning_sample_limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "consequence_profile": {
            "enum": [
              "CP2",
              "CP3"
            ]
          }
        }
      },
      "then": {
        "required": [
          "authority_formation",
          "response_duty_effect"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "IAF-28"
          }
        }
      },
      "then": {
        "required": [
          "authority_formation",
          "constituting_instrument",
          "legal_power"
        ],
        "properties": {
          "authority_formation": {
            "enum": [
              "retained",
              "delegated",
              "transferred",
              "concurrent",
              "jointly_constituted",
              "absent"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "IAF-47"
          }
        }
      },
      "then": {
        "required": [
          "recipient_refs",
          "response_duty_effect",
          "response_duty_source",
          "acknowledgment_clock_source",
          "decision_clock_source"
        ],
        "properties": {
          "recipient_refs": {
            "minItems": 1
          },
          "handoff_state": {
            "enum": [
              "offered",
              "acknowledged",
              "accepted",
              "partially_accepted",
              "capacity_limited",
              "refused",
              "deferred",
              "referred",
              "timed_out",
              "misrouted",
              "constitutional_gap",
              "returned",
              "closed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "enum": [
              "IAF-03",
              "IAF-26",
              "IAF-29",
              "IAF-31",
              "IAF-32",
              "IAF-38",
              "IAF-40",
              "IAF-43",
              "IAF-44",
              "IAF-45"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pilot_type": {
            "enum": [
              "acceptability",
              "feasibility",
              "mechanism",
              "operational",
              "system_effect",
              "institutionalization"
            ]
          },
          "pilot_complexity_band": {
            "enum": [
              "B1",
              "B2",
              "B3",
              "B4"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "activated"
          }
        }
      },
      "then": {
        "required": [
          "effective_at",
          "authority_record_refs",
          "activation_record_refs"
        ],
        "properties": {
          "authority_record_refs": {
            "minItems": 1
          },
          "activation_record_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority_effect": {
            "enum": [
              "authorizing",
              "activating",
              "executing"
            ]
          }
        }
      },
      "then": {
        "required": [
          "authority_record_refs"
        ],
        "properties": {
          "authority_record_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
