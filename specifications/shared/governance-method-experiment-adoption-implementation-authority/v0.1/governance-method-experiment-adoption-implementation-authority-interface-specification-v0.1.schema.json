{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.globalgovernanceframeworks.org/gmeia/0.1/record.schema.json",
  "title": "GMEAIA/0.1 Record Envelope",
  "type": "object",
  "required": [
    "record_id",
    "record_type",
    "schema_version",
    "created_at",
    "status",
    "normative_force",
    "authority_effect",
    "action_class",
    "actor_id",
    "actor_type",
    "public_summary",
    "access_class",
    "human_accountable_officer",
    "prohibited_inferences"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^gmeia:[A-Za-z0-9._:-]+$"
    },
    "record_type": {
      "type": "string",
      "pattern": "^GMEAIA-(0[1-9]|[1-5][0-9]|60)$"
    },
    "schema_version": {
      "const": "0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "draft",
        "asserted",
        "received",
        "validated_for_purpose",
        "referred",
        "proposed",
        "under_deliberation",
        "consent_pending",
        "authority_pending",
        "authorized",
        "registered",
        "activated",
        "paused",
        "suspended",
        "expired",
        "terminated",
        "closed",
        "corrected",
        "superseded",
        "rejected",
        "unresolved",
        "non_activated"
      ]
    },
    "normative_force": {
      "enum": [
        "descriptive",
        "advisory",
        "procedural",
        "evidentiary",
        "consent",
        "authorizing",
        "activating",
        "executing",
        "closing"
      ]
    },
    "authority_effect": {
      "enum": [
        "none",
        "advisory",
        "procedural_support",
        "evidentiary",
        "consent_evidence",
        "authority_reference",
        "authorizing",
        "activating",
        "executing",
        "closing"
      ]
    },
    "action_class": {
      "enum": [
        "A01",
        "A02",
        "A03",
        "A04",
        "A05",
        "A06",
        "A07",
        "A08",
        "A09",
        "A10",
        "A11",
        "A12",
        "A13",
        "A14",
        "A15",
        "A16",
        "A17",
        "A18"
      ]
    },
    "source_framework_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_framework_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actor_id": {
      "type": "string"
    },
    "actor_type": {
      "enum": [
        "human",
        "community",
        "public_body",
        "private_organization",
        "indigenous_nation",
        "ai_system",
        "sensor",
        "technical_service",
        "other"
      ]
    },
    "office_or_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "representation_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "technical_credential_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constituting_instrument": {
      "type": [
        "string",
        "null"
      ]
    },
    "legal_power": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction_territorial": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction_personal": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction_subject_matter": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction_temporal": {
      "type": [
        "string",
        "null"
      ]
    },
    "affected_party_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_indigenous_nation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protected_domain_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consent_record_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_record_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activation_record_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "access_class": {
      "enum": [
        "PUBLIC",
        "AFFECTED_PARTIES",
        "DECISION_BODY",
        "INDEPENDENT_REVIEW",
        "PROTECTED_PERSONAL",
        "PROTECTED_INDIGENOUS",
        "PROTECTED_SOURCE",
        "SECURITY_RESTRICTED",
        "SEALED_LEGAL"
      ]
    },
    "public_summary": {
      "type": "string",
      "minLength": 1
    },
    "protected_annex_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_purpose": {
      "type": [
        "string",
        "null"
      ]
    },
    "retention_rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "correction_status": {
      "enum": [
        "none",
        "requested",
        "under_review",
        "corrected",
        "retracted",
        "superseded"
      ]
    },
    "challenge_status": {
      "enum": [
        "none",
        "open",
        "interim_relief",
        "decided",
        "appealed",
        "closed"
      ]
    },
    "review_due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "closure_state": {
      "enum": [
        "not_applicable",
        "open",
        "closing",
        "closed",
        "unresolved_duties"
      ]
    },
    "unresolved_duty_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff_state": {
      "enum": [
        "not_requested",
        "prepared",
        "sent",
        "received",
        "accepted",
        "partially_accepted",
        "rejected",
        "returned",
        "closed",
        "unresolved"
      ]
    },
    "recipient_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recipient_acceptance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hashes_and_signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "algorithm",
          "value"
        ],
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "human_accountable_officer": {
      "type": "string",
      "minLength": 1
    },
    "prohibited_inferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "activated"
          }
        }
      },
      "then": {
        "required": [
          "effective_at",
          "authority_record_refs",
          "activation_record_refs"
        ],
        "properties": {
          "authority_record_refs": {
            "minItems": 1
          },
          "activation_record_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "GMEAIA-22"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "draft",
              "under_deliberation",
              "authority_pending",
              "registered",
              "rejected",
              "corrected",
              "superseded",
              "non_activated"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "actor_type": {
            "enum": [
              "ai_system",
              "sensor",
              "technical_service"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "authority_effect": {
            "enum": [
              "none",
              "advisory",
              "procedural_support",
              "evidentiary",
              "authority_reference"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}